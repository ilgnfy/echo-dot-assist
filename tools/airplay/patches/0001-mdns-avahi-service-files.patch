+static int hm_service_file(const char *path, const char *name, const char *type, int port, char **txt) {
+  char tmp[300];
+  snprintf(tmp, sizeof tmp, "%s.new", path);
+  FILE *f = fopen(tmp, "w");
+  if (!f)
+    return -1;
+  fputs("<?xml version=\"1.0\" standalone='no'?>\n<!DOCTYPE service-group SYSTEM \"avahi-service.dtd\">\n<service-group>\n<name>", f);
+  hm_xml(f, name);
+  fprintf(f, "</name>\n<service>\n<type>%s</type>\n<port>%d</port>\n", type, port);
+  for (; txt && *txt; txt++) {
+    fputs("<txt-record>", f);
+    hm_xml(f, *txt);
+    fputs("</txt-record>\n", f);
+  }
+  fputs("</service>\n</service-group>\n", f);
+  fchmod(fileno(f), 0644);
+  if (fclose(f) != 0 || rename(tmp, path) != 0) {
+    unlink(tmp);
+    return -1;
+  }
+  return 0;
+}
 

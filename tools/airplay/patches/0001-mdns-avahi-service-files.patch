+/*
+ * hassmic: the "external-avahi" backend writes the stock avahi-daemon's service files itself instead of running avahi-publish-service, which the Echo
+ * does not have and which could not carry AirPlay 2's text records anyway (the stock backend publishes the classic RAOP record only).  One file per
+ * service, in HASSMIC_AVAHI_DIR (default /data/misc/avahi/services); avahi notices a new or changed file by itself.
+ */
+#include <stdlib.h>
+#include <sys/stat.h>
+
+static char hm_raop_file[256], hm_ap2_file[256];
+
+static void hm_xml(FILE *f, const char *s) {
+  for (; *s; s++)
+    switch (*s) {
+    case '&': fputs("&amp;", f); break;
+    case '<': fputs("&lt;", f); break;
+    case '>': fputs("&gt;", f); break;
+    case '"': fputs("&quot;", f); break;
+    default: fputc(*s, f);
+    }
+}
 
-  char *argvwithoutmetadata[] = {
-      NULL, ap1name, config.regtype, mdns_port, MDNS_RECORD_WITHOUT_METADATA, NULL};

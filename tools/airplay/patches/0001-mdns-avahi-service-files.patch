+static int mdns_external_avahi_register(char *ap1name, char *ap2name, __attribute__((unused)) int port, char **txt_records,
+                                        char **secondary_txt_records) {
+  const char *dir = getenv("HASSMIC_AVAHI_DIR");
+  if (!dir)
+    dir = "/data/misc/avahi/services";
+  snprintf(hm_raop_file, sizeof hm_raop_file, "%s/airplay-raop.service", dir);
+  snprintf(hm_ap2_file, sizeof hm_ap2_file, "%s/airplay-ap2.service", dir);
+  snprintf(hm_ap1, sizeof hm_ap1, "%s", ap1name);
+  snprintf(hm_ap2, sizeof hm_ap2, "%s", ap2name);
+  hm_names_set = 1;
+  hm_write(txt_records, secondary_txt_records);
+  return 0;
+}
 
